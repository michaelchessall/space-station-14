## A place to store all sorts of "meta" localization strings.

list-two =
    .and = {$a} and {$b}
    .or  = {$a} or {$b}
    .custom = {$a} {$custom} {$b}
list-last =
    .and = {$rest}, and {$last}
    .or  = {$rest}, or {$last}
    .custom = {$rest}, {$custom} {$last}
list-next = {$rest}, {$next}