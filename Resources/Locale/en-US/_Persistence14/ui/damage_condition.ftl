damage-condition-total =
    .lesser  = target damage total is at most {$max}
    .greater = target damage total is at least {$min}
    .between = target damage total is between {$min} and {$max}

damage-condition-specific =
    .lesser  = target {$types} damage total is at most {$max}
    .greater = target {$types} damage total is at least {$min}
    .between = target {$types} damage total is between {$min} and {$max}
