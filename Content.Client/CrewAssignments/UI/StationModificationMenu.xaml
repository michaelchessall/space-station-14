<controls:FancyWindow xmlns="https://spacestation14.io"
                           xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                           xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                           SetSize="600 690"
                           MinSize="600 690">
    <BoxContainer Orientation="Vertical" Margin="15 5 15 10">
        <BoxContainer Orientation="Horizontal">
            <Label Name="StationNameLabel"
                   Text="Station Name:"
                   StyleClasses="LabelKeyText" />
        </BoxContainer>
        <Control MinHeight="10"/>
        <TabContainer Name="TabContainer" VerticalExpand="True">
            <!-- General Management -->
            <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="15 5 15 10">
                <Control MinHeight="5"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Change Faction Name:"
                      StyleClasses="LabelKeyText" />
                    <Control MinWidth="20"/>
                    <LineEdit Name="StationNameField"
                    PlaceHolder="{Loc 'cargo-console-menu-search-bar-placeholder'}"
                    Access="Public"
                    HorizontalExpand="True" />
                    <Button Name="StationNameConfirm"
                    Access="Public"
                    Text="Save"/>
                </BoxContainer>
                                <Control MinHeight="10"/>
                                <BoxContainer Orientation="Horizontal">
                                        <Label Text="Faction Tag:"
                                            StyleClasses="LabelKeyText" />
                                        <Control MinWidth="20"/>
                                        <LineEdit Name="FactionTagField"
                                        Access="Public"
                                        MinWidth="48"
                                        HorizontalExpand="False" />
                                        <Button Name="FactionTagConfirm"
                                        Access="Public"
                                        Text="Save"/>
                                </BoxContainer>
                <Control MinHeight="15"/>
                <BoxContainer Orientation="Horizontal" MinHeight="80">
                    <Label Text="Current Faction Owners:"
                      StyleClasses="LabelKeyText" />
                    <Control MinWidth="20"/>
                    <PanelContainer VerticalExpand="True"
                                    HorizontalExpand="True"
                               SizeFlagsStretchRatio="1"
                               Name="StationOwnersPC">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#000000" />
                        </PanelContainer.PanelOverride>
                        <ScrollContainer VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" Margin="5" MinHeight ="10">
                                <BoxContainer Name="Requests"
                                              Orientation="Vertical"
                                              VerticalExpand="True">
                                </BoxContainer>
                            </BoxContainer>
                        </ScrollContainer>
                    </PanelContainer>

                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Control MinWidth="215"/>
                    <LineEdit Name="NewOwnerField"
                     PlaceHolder="New Owner"
                     Access="Public"
                     HorizontalExpand="True" />
                    <Button Name="NewOwnerConfirm"
                    Text="Save"
                    Access="Public"/>
                </BoxContainer>
                <Control MinHeight="15"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Create Access:"
                        StyleClasses="LabelKeyText" />
                    <Control MinWidth="20"/>
                    <LineEdit Name="AccessCreateField"
                        PlaceHolder="Access Name"
                        Access="Public"
                        HorizontalExpand="True" />
                    <Button Name="AccessCreateConfirm"
                        Access="Public"
                        Text="Create"/>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Control HorizontalExpand="True"/>
                    <Button Name="DefaultAccessCreate"
                        Access="Public"
                        Text="Create Default Accesses"/>
                </BoxContainer>
                <Control MinHeight="15"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Delete Access:" Margin="0 0 10 0"
                           StyleClasses="LabelKeyText" />
                    <Control HorizontalExpand="True"/>
                    <OptionButton Name="PossibleAccesses" Access="Public"/>
                    <Button Name="AccessDeleteConfirm"
                        Access="Public"
                        Text="Delete"/>
                </BoxContainer>
                <Control MinHeight="50"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Job Network Status:" Margin="0 0 10 0"
                           StyleClasses="LabelKeyText" />
                    <Control HorizontalExpand="True"/>
                    <Button Name="JobNetOn"
                        Access="Public"
                        Text="Enabled"/>
                    <Button Name="JobNetOff"
                        Access="Public"
                        Text="Disabled"/>
                </BoxContainer>
                <Control MinHeight="50"/>
                <Label Text="-Claim Trade Station To Enable Tax Settings-"
                        Name ="ClaimTradeStationLabel"
                        StyleClasses="LabelKeyText"
                        Access="Public" />
                <BoxContainer Orientation="Vertical" Name="TaxOptions" Access="Public">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Import Tax:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <SpinBox Name="ITaxSpinBox" Access="Public" MinWidth="100" Value="0"/>
                        <Button Name="ITaxConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Export Tax:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <SpinBox Name="ETaxSpinBox" Access="Public" MinWidth="100" Value="0"/>
                        <Button Name="ETaxConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Sales Tax:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <SpinBox Name="STaxSpinBox" Access="Public" MinWidth="100" Value="0"/>
                        <Button Name="STaxConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                </BoxContainer>

            </BoxContainer>
            <!-- Assignment Management -->
            <BoxContainer Orientation="Vertical" Margin="15">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Selected Assignment:" Margin="0 0 10 0"
                           StyleClasses="LabelKeyText" />
                    <Control HorizontalExpand="True"/>
                    <OptionButton Name="PossibleAssignments" Access="Public"/>
                </BoxContainer>
                <Control MinHeight="30"/>
                <BoxContainer  Name="AssignmentDetails" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Assignment Name:"
                            StyleClasses="LabelKeyText" />
                        <Control MinWidth="20"/>
                        <LineEdit Name="AssignmentNameField"
                            PlaceHolder="Assignment Name"
                            Access="Public"
                            HorizontalExpand="True" />
                        <Button Name="AssignmentNameConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Wage:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <SpinBox Name="WageSpinBox" Access="Public" MinWidth="100" Value="10"/>
                        <Button Name="AssignmentWageConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Command Level:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <SpinBox Name="CLevelSpinBox" Access="Public" MinWidth="100" Value="10"/>
                        <Button Name="CommandLevelConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Spending Limit:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <SpinBox Name="SpendingLimitSpinBox" Access="Public" MinWidth="100" Value="10"/>
                        <Button Name="SpendingLimitConfirm" Access="Public"
                            Text="Save"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Core Functions:"
                            StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <Button Name="ReassignmentBtn" Access="Public" Text="REASSIGN" ToggleMode="True"/>
                        <Button Name="ClaimBtn" Access="Public" Text="CLAIM"  ToggleMode="True"/>
                        <Button Name="GenRecBtn" Access="Public" Text="GEN RECORD"  ToggleMode="True"/>
                    </BoxContainer>
                    <Control MinHeight="15"/>
                    <BoxContainer Orientation="Vertical">
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="Access:"
                                StyleClasses="LabelKeyText" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" MinHeight="150">
                            <PanelContainer VerticalExpand="True"
                                            HorizontalExpand="True"
                                       SizeFlagsStretchRatio="1"
                                       Name="AssignmentAccessesPC">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#000000" />
                                </PanelContainer.PanelOverride>
                                <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                                    <BoxContainer Orientation="Vertical" Margin="5" MinHeight ="10">
                                        <WrapContainer Name="AssignmentAccessesBC"
                                            Access="Public"
                                            VerticalExpand="True"
                                            MaxWidth="500">

                                        </WrapContainer>
                                    </BoxContainer>
                                </ScrollContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
                    <Control VerticalExpand="True"/>
                    <BoxContainer Name="DeleteContainer" Orientation="Horizontal">
                        <Control HorizontalExpand="True"/>
                        <Button Name="DeleteAssignment" Access="Public"
                            Text="Delete Selected Assignment"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <LineEdit Name="NewAssignmentNameField" Access="Public"
                            PlaceHolder="New Assignment Name"
                            HorizontalExpand="True" />
                        <Button Name="CreateAssignment" Access="Public"
                            Text="Create New Assignment"/>
                    </BoxContainer>

            </BoxContainer>
            <!-- Radio Management -->
            <BoxContainer Orientation="Vertical" Margin="15" VerticalExpand="True">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Selected Channel:" Margin="0 0 10 0"
                           StyleClasses="LabelKeyText" />
                    <Control HorizontalExpand="True"/>
                    <OptionButton Name="PossibleChannels" Access="Public"/>
                </BoxContainer>
                <Control MinHeight="30"/>
                <BoxContainer  Name="ChannelDetails" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Channel Status:" StyleClasses="LabelKeyText" />
                        <Control HorizontalExpand="True"/>
                        <Button Name="ChannelEnable" Access="Public" Text="Enabled"/>
                        <Button Name="ChannelDisable" Access="Public" Text="Disabled"/>
                    </BoxContainer>
                </BoxContainer>
                <Control MinHeight="12"/>
                <BoxContainer Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Create Channel:" StyleClasses="LabelKeyText" />
                        <Control MinWidth="10"/>
                        <LineEdit Name="CustomChannelName" Access="Public" PlaceHolder="Name" HorizontalExpand="True"/>
                        <Control MinWidth="6"/>
                        <LineEdit Name="CustomChannelHotkey" Access="Public" PlaceHolder="Key" MinWidth="46"/>
                        <Control MinWidth="6"/>
                        <Button Name="CreateChannelButton" Access="Public" Text="Create"/>
                    </BoxContainer>
                </BoxContainer>
                <Control MinHeight="12"/>
                <BoxContainer Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Edit Selected:" StyleClasses="LabelKeyText" />
                        <Control MinWidth="17"/>
                        <LineEdit Name="EditChannelName" Access="Public" PlaceHolder="Name" HorizontalExpand="True"/>
                        <Control MinWidth="6"/>
                        <LineEdit Name="EditChannelHotkey" Access="Public" PlaceHolder="Key" MinWidth="46"/>
                        <Control MinWidth="6"/>
                        <Button Name="EditChannelButton" Access="Public" Text="Save"/>
                        <Control MinWidth="6"/>
                        <Button Name="DeleteChannelButton" Access="Public" Text="Delete"/>
                    </BoxContainer>
                    <Control MinHeight="8"/>
                    <BoxContainer Orientation="Horizontal">
                        <Control MinWidth="149"/>
                        <Label Text="Color:" MinWidth="44"/>
                        <ColorSelectorSliders Name="ChannelColorPicker" Access="Public" IsAlphaVisible="False" SelectorType="Hsv" HorizontalExpand="True" MinHeight="44"/>
                        <Control MinWidth="6"/>
                        <PanelContainer Name="ChannelColorPreview" MinSize="32 32">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#2cdb2c" BorderColor="#808080" BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>
                    </BoxContainer>
                    <Control MinHeight="4"/>
                    <Label Name="EditChannelHint" Text="Select a custom channel to edit. Color applies to both Create and Save." Margin="149 0 0 0"/>
                </BoxContainer>
                <Control MinHeight="10"/>
                <BoxContainer Orientation="Vertical" VerticalExpand="True">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Access:"
                            StyleClasses="LabelKeyText" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" VerticalExpand="True" MinHeight="90">
                        <PanelContainer VerticalExpand="True"
                                        HorizontalExpand="True"
                                    SizeFlagsStretchRatio="1"
                                    Name="ChannelAccessesPC">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#000000" />
                            </PanelContainer.PanelOverride>
                            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" Margin="5" MinHeight ="10">
                                    <WrapContainer Name="ChannelAccessesBC"
                                        Access="Public"
                                        VerticalExpand="True"
                                        MaxWidth="500">

                                    </WrapContainer>
                                </BoxContainer>
                            </ScrollContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <!-- Upgrade Management -->
            <BoxContainer Orientation="Vertical" Margin="15">
                <Control MinHeight="5"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Current Faction Level:"
                      StyleClasses="LabelKeyText" />
                    <Control MinWidth="20"/>
                    <Label Name="CurrentFactionLevelLabel" Text="Small Faction" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" MinHeight="100">
                    <PanelContainer VerticalExpand="True"
                                    HorizontalExpand="True"
                               SizeFlagsStretchRatio="1"
                               Name="CurrentLevelDescPC">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#000000" />
                        </PanelContainer.PanelOverride>
                        <RichTextLabel Name="CurrentBenefitsLabel" VerticalExpand="True" HorizontalExpand="True" MinHeight="100"/>
                    </PanelContainer>

                </BoxContainer>
                <Control MinHeight="20" />
                <BoxContainer Orientation="Horizontal">
                    <Label Text="Next Faction Level:"
                      StyleClasses="LabelKeyText" />
                    <Control MinWidth="20"/>
                    <Label Name="NextFactionLevelLabel" Text="Standard Faction" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" MinHeight="100">
                    <PanelContainer VerticalExpand="True"
                                    HorizontalExpand="True"
                               SizeFlagsStretchRatio="1"
                               Name="NextLevelDescPC">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#000000" />
                        </PanelContainer.PanelOverride>
                        <RichTextLabel Name="NextBenefitsLabel"  VerticalExpand="True" HorizontalExpand="True"  MinHeight="100"/>
                    </PanelContainer>
                </BoxContainer>

                <BoxContainer Orientation="Horizontal">
                    <Label Text="Faction Account:"
                      StyleClasses="LabelKeyText" />
                    <Label Name="AccountBalanceLabel" Text="" />
                    <Control HorizontalExpand="True" />
                    <Label Text="Purchase Upgrade:"
                      StyleClasses="LabelKeyText" />
                    <Button Name="LevelPurchaseButton" Access="Public" />
                </BoxContainer>
            </BoxContainer>

        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
