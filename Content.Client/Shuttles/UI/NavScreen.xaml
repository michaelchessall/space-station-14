<BoxContainer
    Visible="False"
    HorizontalExpand="True"
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">

    <ui:ShuttleNavControl
        Name="NavRadar"
        MouseFilter="Stop"
        VerticalAlignment="Stretch"
        VerticalExpand="True"
        HorizontalExpand="True"
        Margin="5 4 10 5"/>

    <!-- Nav controls -->
    <BoxContainer
        Name="RightDisplayNav"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        VerticalExpand="True"
        MinWidth="256"
        MaxWidth="256"
        Margin="5 0 5 5"
        Orientation="Vertical">

        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavDisplayLabel"
                Text="{Loc 'shuttle-console-display-label'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>

        <GridContainer
            Columns="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalExpand="True"
            Margin="3"
            Name="ReadonlyDisplay">

            <Label Text="{Loc 'shuttle-console-name'}"/>
            <Label
                Name="GridName"
                Text="{Loc 'shuttle-console-unknown'}"
                HorizontalExpand="True"
                Align="Right"/>

            <Label Text="{Loc 'shuttle-console-position'}"/>
            <Label
                Name="GridPosition"
                Text="0.0, 0.0"
                HorizontalExpand="True"
                Align="Right"/>

            <Label Text="{Loc 'shuttle-console-sector'}"/>
            <Label
                Name="GridSector"
                Text="Center"
                HorizontalExpand="True"
                Align="Right"/>

            <Label Text="{Loc 'shuttle-console-hazard-event'}"/>
            <Label
                Name="GridHazardWeather"
                Text="None"
                HorizontalExpand="True"
                Align="Right"/>

            <Label Text="{Loc 'shuttle-console-orientation'}"/>
            <Label
                Name="GridOrientation"
                Text="0.0"
                HorizontalExpand="True"
                Align="Right"/>

            <Label Text="{Loc 'shuttle-console-linear-velocity'}"/>
            <Label
                Name="GridLinearVelocity"
                Text="0.0, 0.0"
                HorizontalExpand="True"
                Align="Right"/>

            <Label Text="{Loc 'shuttle-console-angular-velocity'}"/>
            <Label
                Name="GridAngularVelocity"
                Text="0.0"
                HorizontalExpand="True"
                Align="Right"/>
        </GridContainer>

        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavSettingsLabel"
                Text="{Loc 'shuttle-console-nav-settings'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>

        <Button
            Name="IFFToggle"
            Text="{Loc 'shuttle-console-iff-toggle'}"
            TextAlign="Center"
            ToggleMode="True"/>

        <Button
            Name="DockToggle"
            Text="{Loc 'shuttle-console-dock-toggle'}"
            TextAlign="Center"
            ToggleMode="True"/>

        <Label
            Text="{Loc 'shuttle-console-sort-label'}"
            HorizontalExpand="True"/>

        <BoxContainer
            Orientation="Horizontal"
            HorizontalExpand="True"
            SeparationOverride="10">

            <CheckBox
                Name="FilterStation"
                Text="{Loc 'shuttle-console-sort-station'}"/>

            <CheckBox
                Name="FilterShip"
                Text="{Loc 'shuttle-console-sort-ship'}"/>

            <CheckBox
                Name="FilterOther"
                Text="{Loc 'shuttle-console-sort-other'}"/>
        </BoxContainer>

        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavControlsLabel"
                Text="{Loc 'shuttle-console-nav-controls'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>

        <Label
            Text="{Loc 'shuttle-console-damping-label'}"
            HorizontalExpand="True"/>

        <BoxContainer
            Name="DampingModeSelectorContainer"
            MinWidth="120"/>
    </BoxContainer>
</BoxContainer>